    <xs:complexType name="named_attribute_datevalue">
        <xs:annotation>
            <xs:documentation>Represents a date of the W3C form YYYY-MM-DD (e.g: 2012-08-01).  This
                form assumes the local timezone.</xs:documentation>
            <xs:documentation>For date in UTC (timezone Zulu), format is YYYY-MM-DDZ (e.g:
