                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" name="Width_mm" type="xs:positiveInteger">
                <xs:annotation>
                    <xs:documentation>Width in millimetres</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType abstract="false" name="circular_struct_mm">
        <xs:annotation>
