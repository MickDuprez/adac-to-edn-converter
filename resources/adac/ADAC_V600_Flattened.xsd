        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="object_abstract">
                <xs:sequence maxOccurs="1" minOccurs="1">
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Type"
                        nillable="false" type="String_64">
                        <xs:annotation>
                            <xs:documentation>The type of dimension.  Data users can determine the
                                presentation to apply to each type of dimension.</xs:documentation>
                            <xs:documentation>This element is not constrained but the simpleType
                                enhancement_dimension_type provides some suggested standard classes
                                of dimension.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Measure"
                        nillable="false" type="xs:float">
                        <xs:annotation>
                            <xs:documentation>The measurement being represented.  No units are
                                specified, but it is expected that all dimensions of the same type
                                will be expressed in the same units, allowing uniform presentations
                                to be applied in client applications.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="FromFeatureId"
                        nillable="true" type="String_40">
                        <xs:annotation>
                            <xs:documentation>The ObjectId of the feature being measured
                                from</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="ToFeatureId"
                        nillable="true" type="String_40">
                        <xs:annotation>
                            <xs:documentation>The ObjectId of the feature being measured
                                to</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="RefLineFrom"
                        nillable="true" type="pair_of_offsets">
                        <xs:annotation>
                            <xs:documentation>A pair of decimal offsets in map units describing the
                                extent of the reference line at the start of the baseline.  Negative
                                measures are left of the baseline, positive measures are right in
                                the direction of the baseline.</xs:documentation>
                            <xs:documentation>E.g: the values -0.5 4.0 represent a line through the
                                start point, perpendicular to the baseline, that runs from 0.5m left
                                of the baseline to 4.0m right.  By convention the leftmost offset
                                should be stated first.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="RefLineTo"
                        nillable="true" type="pair_of_offsets">
                        <xs:annotation>
                            <xs:documentation>A pair of decimal offsets in map units describing the
                                extent of the reference line at the end of the baseline.  Negative
                                measures are left of the baseline, positive measures are right in
                                the direction of the baseline.</xs:documentation>
                            <xs:documentation>E.g: the values -0.5 4.0 represent a line through the
                                end point, perpendicular to the baseline, that runs from 0.5m left
                                of the baseline to 4.0m right.  By convention the leftmost offset
                                should be stated first.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="BaseLineOffset"
                        nillable="true" type="xs:float">
                        <xs:annotation>
                            <xs:documentation>A single decimal offset in map units describing the
                                position of the measure line parallel to the baseline.  Negative
                                measures are left of the baseline, positive measures are right in
                                the direction of the baseline.</xs:documentation>
                            <xs:documentation>E.g: the value 2.0 represents a measure line parallel
                                to the baseline, that runs from 2.0m right of the
                                baseline.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_linear_segment_simple">
                        <xs:annotation>
                            <xs:documentation>Line segment geometry representing the baseline (start
                                and end point) of the dimension in coordinate space.  The start and
                                end points should represent the actual points being measured from
                                and to</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- Enhancement Objects -->
    <xs:annotation>
        <xs:documentation>The ADAC Supplementary Schema constrains the data structure for all
            unstructured Supplementary features within an ADAC Project</xs:documentation>
        <xs:documentation>These features provide for the ability to describe points, polylines or
            polygons.  A class name must be set on each feature and a text note may be provided.
            The class value may be used on extraction to filter features into GIS featureclasses or
            similar.</xs:documentation>
    </xs:annotation>
    <!-- INCLUDES -->
    <!-- Enumerated Types -->
    <!-- Global Types -->
    <!-- Geometry -->
    <!-- **************************************************************************************** -->
    <!-- SupplementaryData - Contains unstructured data not included in the rigourous ADAC model  -->
    <!-- **************************************************************************************** -->
    <xs:complexType name="objectModelSupplementary">
        <xs:annotation>
            <xs:documentation>Data structure for generic description of objects not described
                elsewhere in the ADAC data model.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="PointFeatures"
                nillable="false">
                <xs:annotation>
                    <xs:documentation>Represents a GIS layer of Supplementary point
                        features.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                            name="PointFeature" nillable="false" type="Feature_Supplementary_Point">
                            <xs:annotation>
                                <xs:documentation>Represents a Supplementary point
                                    feature</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="PolylineFeatures"
                nillable="false">
                <xs:annotation>
                    <xs:documentation>Represents a GIS layer of Supplementary polyline
                        features.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                            name="PolylineFeature" nillable="false"
                            type="Feature_Supplementary_Polyline">
                            <xs:annotation>
                                <xs:documentation>Represents a Supplementary polyline
                                    feature</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="PolygonFeatures"
                nillable="false">
                <xs:annotation>
                    <xs:documentation>Represents a GIS layer of Supplementary polygon
                        features.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                            name="PolygonFeature" nillable="false"
                            type="Feature_Supplementary_Polygon">
                            <xs:annotation>
                                <xs:documentation>Represents a Supplementary polygon
                                    feature</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <!-- **************************************************************************************** -->
    <!-- FEATURES  - Supplementary                                                                -->
    <!-- **************************************************************************************** -->
    <!-- FEATURE Supplementary POINT-->
    <xs:complexType abstract="false" name="Feature_Supplementary_Point">
        <xs:annotation>
            <xs:documentation>Represents a Supplementary point feature.  Use these features to
                represent point detail that adds clarity or context to the strict ADAC
                features.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <!--Ben Pham modified: changed base extension from object_abstract to asset_abstract-->
            <xs:extension base="asset_abstract">
                <xs:sequence>
                    <xs:group ref="supplementary_content">
                        <xs:annotation>
                            <xs:documentation>Standard content for supplementary
                                features</xs:documentation>
                        </xs:annotation>
                    </xs:group>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_point_singlepoint">
                        <xs:annotation>
                            <xs:documentation>Represents a point geometry</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- FEATURE Supplementary POLYLINE -->
