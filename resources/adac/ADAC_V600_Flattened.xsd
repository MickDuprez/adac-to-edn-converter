                    <xs:documentation>Aquifer Storage</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Energy Dissipation">
                <xs:annotation>
                    <xs:documentation>The dissipation of kinetic energy from flowing storwater to
