        </xs:annotation>
        <xs:sequence>
            <xs:element form="qualified" name="Diameter_mm" type="xs:positiveInteger">
                <xs:annotation>
                    <xs:documentation>Diameter in millimetres</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType abstract="false" name="extended_struct_mm">
        <xs:annotation>
            <xs:documentation>Used for the expression of a shape with parallel sides and circular
                ends.  Dimensions are in millimetres.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element form="qualified" name="Radius_mm" type="xs:positiveInteger">
