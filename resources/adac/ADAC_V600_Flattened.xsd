                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" name="Extension_mm" type="xs:positiveInteger">
                <xs:annotation>
                    <xs:documentation>Distance, in millimetres, between the centre points of the
                        circular ends</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType abstract="false" name="custom_area_struct_sqm">
