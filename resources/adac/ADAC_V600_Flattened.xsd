                    <xs:documentation>The Manufacturer of the unit</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="ModelNumber"
                nillable="true" type="String_64">
                <xs:annotation>
                    <xs:documentation>The standard code, model number or part number for the
