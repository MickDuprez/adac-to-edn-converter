    <!-- *** ROOT ADAC ELEMENT *********************** -->
    <!-- **************************************************************************************** -->
    <!-- ADAC element consists of Project containing all other objects                            -->
    <!-- **************************************************************************************** -->
    <xs:element name="ADAC" nillable="false">
        <xs:annotation>
            <xs:documentation>The ADAC element is the root element of an ADAC XML.  It constrains
                all enclosed elements as follows.  There can be no other element in the root level
                of the document.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence maxOccurs="1" minOccurs="1">
                <xs:element maxOccurs="1" minOccurs="1" name="Project" nillable="false">
                    <xs:annotation>
                        <xs:documentation>The Project element encloses all data that is common to
                            the whole project.</xs:documentation>
                        <xs:documentation>In Version 4.1.0, for technical simplicity, only a single
                            project may exist within an instance document, but in future it may be
                            feasible for multiple independent projects to be delivered in a single
                            instance.</xs:documentation>
                        <xs:documentation>In version 4.2.0 while this limitation remains, certain
                            fields at the project level have been repeated at the asset level to
                            allow assets to differ from the global values set in
                            Project</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence maxOccurs="1" minOccurs="1">
                            <xs:element maxOccurs="1" minOccurs="1" name="ExportDateTime"
                                nillable="false" type="xs:dateTime">
                                <xs:annotation>
                                    <xs:documentation>Export date and time in UTC. Format is
                                        yyyy-mm-ddThh:mm:ssZ (eg 2006-08-08T20:00:00Z) ISO
                                        8601.</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="Name" nillable="false"
                                type="String_254">
                                <xs:annotation>
                                    <xs:documentation>The project or development
                                        name.</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="Owner" nillable="false"
                                type="String_32">
                                <xs:annotation>
                                    <xs:documentation>Are assets for the whole project owned by
                                        Council or another entity.</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="Receiver" nillable="false"
                                type="String_254">
                                <xs:annotation>
                                    <xs:documentation>The receiver of the ADAC
                                        file</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="WorksApprovalID"
                                nillable="true" type="String_64">
                                <xs:annotation>
                                    <xs:documentation>The works approval ID for the development that
                                        this information represents.</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="DrawingNumber"
                                nillable="false" type="String_64">
                                <xs:annotation>
                                    <xs:documentation>The Receiver's drawing number of the as
                                        constructed plans.  This may not be known at the time of
                                        compilation.</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="DrawingRevision"
                                nillable="true" type="xs:date">
                                <xs:annotation>
                                    <xs:documentation>Date the drawing was revised.  ISO 8601 is the
                                        accepted format.</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="ConstructionDate"
                                nillable="false" type="xs:date">
                                <xs:annotation>
                                    <xs:documentation>The accepted date of construction for the
                                        whole project.  Usually the project completion date. ISO
                                        8601 is the accepted format.</xs:documentation>
                                    <xs:documentation>Date may be used to calculate remaining life
                                        in an asset management system.</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="CoordinateSystem"
                                nillable="false">
                                <xs:annotation>
                                    <xs:documentation>Records the particulars of the horizontal and
                                        vertical coordinate systems for the whole
                                        project.</xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:sequence maxOccurs="1" minOccurs="1">
                                        <xs:element maxOccurs="1" minOccurs="1"
                                            name="HorizontalCoordinateSystem" nillable="false"
                                            type="String_64">
                                            <xs:annotation>
                                                <xs:documentation>Specifies the horizontal
                                                  coordinate system used.  e.g. MGA56. Well known
                                                  projections may be referred to by name only.  All
                                                  spatial information in the project will be
                                                  considered to be referenced to this system.  If
                                                  custom local plane systems or projections are used
                                                  by agreement with the receiver, then any
                                                  parameters should be specified in the
                                                  notes.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1"
                                            name="HorizontalDatum" nillable="false" type="String_64">
                                            <xs:annotation>
                                                <xs:documentation>To Specifiy the Datum that the
                                                  Horizontal Coordinate System is based on.  E.g.
                                                  GDA2020.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="VerticalDatum"
                                            nillable="false" type="String_64">
                                            <xs:annotation>
                                                <xs:documentation>To Specifiy the Datum of Height
                                                  values.  E.g. AHD.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="IsApproximate"
                                            nillable="false" type="xs:boolean">
                                            <xs:annotation>
                                                <xs:documentation>Are the values supplied accurate
                                                  or approximations.  If data is plane rectangular
                                                  approximating MGA-56 then set to
                                                  true</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="OriginMark"
                                            nillable="true" type="String_64">
                                            <xs:annotation>
                                                <xs:documentation>When data is plane rectangular
                                                  this is the Permanent Survey Mark used as the
                                                  origin.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="Notes"
                                            nillable="true" type="xs:string">
                                            <xs:annotation>
                                                <xs:documentation>To contain any additional data
                                                  required to specify the coordinate system.  If
                                                  receiving systems are capable of accepting Well
                                                  Known Text (WKT) string definitions of coordinate
                                                  systems, then this element may be used to carry
                                                  them.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="DrawingExtents"
                                nillable="false">
                                <xs:annotation>
                                    <xs:documentation>The rectangular coordinate envelope enclosing
                                        the project area</xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:sequence maxOccurs="1" minOccurs="1">
                                        <xs:element maxOccurs="1" minOccurs="1" name="SouthWest"
                                            nillable="false" type="geometry_position_3d">
                                            <xs:annotation>
                                                <xs:documentation>The coordinates of the southwest
                                                  corner.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="NorthEast"
                                            nillable="false" type="geometry_position_3d">
                                            <xs:annotation>
                                                <xs:documentation>The coordinates of the northeast
                                                  corner.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="Description"
                                nillable="false" type="String_254">
                                <xs:annotation>
                                    <xs:documentation>Descriptive text summarising the
                                        project.</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="ProjectStatus"
                                nillable="false" type="submission_status">
                                <xs:annotation>
                                    <xs:documentation>The reason for the ADAC file creation.  This
                                        is not the same as Asset_status, which is at the asset
                                        level</xs:documentation>
                                    <xs:documentation>Submission Status is usually related to the
                                        development assesment process or to data transfer between
                                        entities or systems</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element maxOccurs="1" minOccurs="1" name="Software" nillable="false">
                                <xs:annotation>
                                    <xs:documentation>Details of the software product used to create
                                        the ADAC data set.</xs:documentation>
                                    <xs:documentation>Software developers may choose to add this
                                        information programmatically via their
                                        product.</xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:sequence maxOccurs="1" minOccurs="1">
                                        <xs:element maxOccurs="1" minOccurs="1" name="Product"
                                            nillable="false" type="xs:string">
                                            <xs:annotation>
                                                <xs:documentation>The name of the software
                                                  product.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="Version"
                                            nillable="false" type="xs:string">
                                            <xs:annotation>
                                                <xs:documentation>The version or release number of
                                                  the product.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <!--Ben Pham added: Surveyor and Engineer elements are now referencing to the complex types defined in ADACGlobalTypes.xsd.-->
                            <!-- Certifying Surveyor -->
                            <xs:element maxOccurs="1" minOccurs="1" name="Surveyor" nillable="true"
                                type="surveyor_details"/>
                            <!-- Certifying Engineer -->
                            <xs:element maxOccurs="1" minOccurs="1" name="Engineer" nillable="true"
                                type="engineer_details"/>
                            <!-- PROJECT DATA -->
                            <!-- ProjectData encloses all feature datasets and hence, every object that is a child of this project -->
                            <xs:element maxOccurs="1" minOccurs="0" name="ProjectData">
                                <xs:complexType>
                                    <xs:sequence maxOccurs="1" minOccurs="1">
                                        <xs:element maxOccurs="1" minOccurs="1" name="Sewerage"
                                            nillable="false" type="objectModelSewerage">
                                            <xs:annotation>
                                                <xs:documentation>The Sewerage element encloses all
                                                  sewerage (waste water) feature
                                                  descriptions.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="Transport"
                                            nillable="false" type="objectModelTransport">
                                            <xs:annotation>
                                                <xs:documentation>The Roads element encloses all
                                                  roads feature descriptions.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="WaterSupply"
                                            nillable="false" type="objectModelWaterSupply">
                                            <xs:annotation>
                                                <xs:documentation>The Water element encloses all
                                                  water supply feature
                                                  descriptions.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="StormWater"
                                            nillable="false" type="objectModelStormWater">
                                            <xs:annotation>
                                                <xs:documentation>The StormWater element encloses
                                                  all stormwater feature
                                                  descriptions.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="OpenSpace"
                                            nillable="false" type="objectModelOpenSpace">
                                            <xs:annotation>
                                                <xs:documentation>The OpenSpace element encloses all
                                                  public open space feature
                                                  descriptions.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="Electrical"
                                            nillable="false" type="objectModelElectrical">
                                            <xs:annotation>
                                                <xs:documentation>The Electrical element encloses
                                                  all electrical feature
                                                  descriptions.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="Communication"
                                            nillable="false" type="objectModelCommunication">
                                            <xs:annotation>
                                                <xs:documentation>The Communication element encloses
                                                  all communication feature
                                                  descriptions.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="Cadastre"
                                            nillable="false" type="objectModelCadastre">
                                            <xs:annotation>
                                                <xs:documentation>The Cadastre element encloses all
                                                  cadastral feature descriptions.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="Surface"
                                            nillable="false" type="objectModelSurface">
                                            <xs:annotation>
                                                <xs:documentation>The Surface element encloses
                                                  Supplementary surface feature
                                                  descriptions.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="Enhancements"
                                            nillable="false" type="objectModelEnhancements">
                                            <xs:annotation>
                                                <xs:documentation>The Enhancements element encloses
                                                  enhacements such as annotations and
                                                  dimensions.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element maxOccurs="1" minOccurs="1" name="Supplementary"
                                            nillable="false" type="objectModelSupplementary">
                                            <xs:annotation>
                                                <xs:documentation>The Supplementary element encloses
                                                  all feature data not described specifically in the
                                                  schema.  It is recommended to keep the use of
                                                  unstructured data to a bare
                                                  minimum.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute fixed="6.0.0" name="version" use="required">
                <xs:annotation>
                    <xs:documentation>The version attribute marks the version of the instance
                        document.  Only a value of 6.0.0 will validate against this schema.
                        Instance documents created against other versions of the ADAC schema should
                        only be validated against the version of the ADAC schema to which they
                        correspond.</xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
