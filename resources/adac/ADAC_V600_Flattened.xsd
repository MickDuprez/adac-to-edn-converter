    <!-- SEWERAGE FEATURE SET -->
    <xs:complexType name="objectModelSewerage">
        <xs:annotation>
            <xs:documentation>Data structure constraining information relating to sewerage (waste
                water) features.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="MaintenanceHoles"
                nillable="false">
                <xs:annotation>
                    <xs:documentation>Element representing the feature class of Sewerage Maintenance
                        Holes (formerly Manholes)</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence maxOccurs="1" minOccurs="1">
                        <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                            name="MaintenanceHole" nillable="false"
                            type="Feature_Sewerage_MaintenanceHole">
                            <xs:annotation>
                                <xs:documentation>Element representing a sewerage Maintenance Hole
                                    (formerly Manhole).</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="MaintenanceShafts"
                nillable="false">
                <xs:annotation>
                    <xs:documentation>Element representing the feature class of Sewerage Maintenance
                        Shafts (Maintenance Structures other than Maintenance
                        Holes)</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence maxOccurs="1" minOccurs="1">
                        <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                            name="MaintenanceShaft" nillable="false"
                            type="Feature_Sewerage_MaintenanceShaft">
                            <xs:annotation>
                                <xs:documentation>Element representing a sewerage maintenance
                                    structure other than a Maintenance Hole.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="PipesNonPressure"
                nillable="false">
                <xs:annotation>
                    <xs:documentation>Element representing the feature class of Sewerage Pipes
                        Non-Pressure</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence maxOccurs="1" minOccurs="1">
                        <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                            name="PipeNonPressure" nillable="false"
                            type="Feature_Sewerage_Pipe_NonPressure">
                            <xs:annotation>
                                <xs:documentation>Element representing a sewer pipe non-pressurised.
                                    Includes all gravity reticulation and trunk gravity
                                    mains.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="PipesPressure"
                nillable="false">
                <xs:annotation>
                    <xs:documentation>Element representing the feature class of Sewerage Pipes
                        Pressure</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence maxOccurs="1" minOccurs="1">
                        <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                            name="PipePressure" nillable="false"
                            type="Feature_Sewerage_Pipe_Pressure">
                            <xs:annotation>
                                <xs:documentation>Element representing a sewer pipe pressurised
                                    (rising main).</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Valves" nillable="false">
                <xs:annotation>
                    <xs:documentation>Element representing the feature class of Sewerage
                        Valves</xs:documentation>
                </xs:annotation>
                <xs:complexType>
