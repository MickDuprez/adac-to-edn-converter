        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:date">
                <xs:attribute form="unqualified" name="valname" type="String_32" use="required">
                    <xs:annotation>
                        <xs:documentation>A name must be supplied for the Feature Attribute.
