                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="BelowGround"
                        nillable="true" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation>Is the fitting below ground</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="WaterSaver"
                        nillable="true" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation>Does the fitting employ waste minimisation technology
                                (other than auto shut-off)</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="AutoShutOff"
                        nillable="true" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation>Does the fitting employ auto shut-off
                                technology</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element default="0" form="qualified" maxOccurs="1" minOccurs="1"
                        name="Rotation" nillable="true" type="Float_Direction">
                        <xs:annotation>
                            <xs:documentation>Rotation angle (cartesian - anti-clockwise 0 degrees =
                                East)</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="WaterQuality"
                        nillable="false" type="water_supply_water_quality">
                        <xs:annotation>
                            <xs:documentation>The quality/source of the water being supplied through
                                the service fitting.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_point_singlepoint">
                        <xs:annotation>
                            <xs:documentation>Point geometry representing the feature in coordinate
                                space.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- FEATURE WATER STORAGE TANK -->
    <xs:complexType abstract="false" name="Feature_Water_StorageTank">
        <xs:annotation>
            <xs:documentation>Represents a domestic storage tank feature.  Includes roof water
                storage not fed from mains service.</xs:documentation>
            <xs:documentation>Not to be used for bulk storage features that are part of the mains
                distribution network</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="asset_abstract">
                <xs:sequence maxOccurs="1" minOccurs="1">
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Material"
                        nillable="false" type="water_storage_tank_material">
                        <xs:annotation>
                            <xs:documentation>The material that the storage tank is made
                                from.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Source"
                        nillable="false" type="water_storage_source">
                        <xs:annotation>
                            <xs:documentation>The source of water in the tank.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:group maxOccurs="1" minOccurs="1" ref="manufacturer_model_details">
                        <xs:annotation>
                            <xs:documentation>Standard element group called in to support
                                manufacturer and model details</xs:documentation>
                        </xs:annotation>
                    </xs:group>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Volume_m3"
                        nillable="false" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>The effective volume in cubic
                                metres.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element default="0" form="qualified" maxOccurs="1" minOccurs="1"
                        name="Rotation" nillable="true" type="Float_Direction">
                        <xs:annotation>
                            <xs:documentation>Rotation angle (cartesian - anti-clockwise 0 degrees =
                                East)</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_point_singlepoint">
                        <xs:annotation>
                            <xs:documentation>Point geometry representing the feature in coordinate
                                space.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
