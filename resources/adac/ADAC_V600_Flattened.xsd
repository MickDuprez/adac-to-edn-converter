    <!-- FEATURE STORMWATER PIT -->
    <xs:complexType abstract="false" name="Feature_StormWater_Pit">
        <xs:annotation>
            <xs:documentation>Represents a stormwater maintenance hole or pit
                feature</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="asset_abstract">
                <xs:sequence maxOccurs="1" minOccurs="1">
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="PitNumber"
                        nillable="false" type="String_32">
                        <xs:annotation>
                            <xs:documentation>The pit identifier.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Use"
                        nillable="false" type="stormwater_pit_use">
                        <xs:annotation>
                            <xs:documentation>Purpose of the feature in the
                                network.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                        name="ChamberConstruction" nillable="false" type="construction_method">
                        <xs:annotation>
                            <xs:documentation>Method of chamber construction.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="ChamberSize"
                        nillable="false">
                        <xs:annotation>
                            <xs:documentation>Represents the essential dimensions of the chamber.
                                Contains a choice of structures that pertain to different
                                configurations.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                            <xs:choice maxOccurs="1" minOccurs="1">
                                <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                    name="Rectangular" nillable="false" type="rectangular_struct_mm">
                                    <xs:annotation>
                                        <xs:documentation>Dimensions of a rectangular
                                            chamber.</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                                <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                    name="Circular" nillable="false" type="circular_struct_mm">
                                    <xs:annotation>
                                        <xs:documentation>Dimensions of a circular
                                            chamber.</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                                <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                    name="Extended" nillable="false" type="extended_struct_mm">
                                    <xs:annotation>
                                        <xs:documentation>Dimensions of a circular
                                            chamber.</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                            </xs:choice>
                        </xs:complexType>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="LidType"
                        nillable="true" type="stormwater_pit_lid_type">
                        <xs:annotation>
                            <xs:documentation>The type of lid or grate covering the
                                opening.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:group maxOccurs="1" minOccurs="1" ref="dimensions_point_levels_m">
                        <xs:annotation>
                            <xs:documentation>Calls in the standard elements for surface and invert
                                levels</xs:documentation>
                        </xs:annotation>
                    </xs:group>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Depth_m"
                        nillable="false" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>The depth of the structure in metres.  May be
                                user-entered, or auto-calculated as the difference between the
                                surface level and the invert level of the pit.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Inlet"
                        nillable="true">
                        <xs:annotation>
                            <xs:documentation>Represents a surface inlet to the pit.  Set to nil if
                                this pit does not have a surface inlet</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                            <xs:sequence maxOccurs="1" minOccurs="1">
                                <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                    name="InletConfig" nillable="false"
                                    type="stormwater_pit_inlet_config">
                                    <xs:annotation>
                                        <xs:documentation>Positioning of the inlet against the pit
                                            when looking at the pit from the verge facing the
                                            road</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                                <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                    name="InletType" nillable="false"
                                    type="stormwater_pit_inlet_type">
                                    <xs:annotation>
                                        <xs:documentation>The type of inlet
                                            employed.</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                                <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                    name="InletSize" nillable="false" type="String_32">
                                    <xs:annotation>
                                        <xs:documentation>Dimensions of the inlet e.g. Diameter or
                                            Length x Width.</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Lintel"
                        nillable="true">
                        <xs:annotation>
                            <xs:documentation>Represents the pit lintel.  Set to nil if this pit
                                does not have a lintel.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                            <xs:sequence maxOccurs="1" minOccurs="1">
                                <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                    name="LintelConstruction" nillable="false"
                                    type="construction_method">
                                    <xs:annotation>
                                        <xs:documentation>Method of lintel
                                            construction.</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                                <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                    name="LintelLength_m" nillable="false"
                                    type="Float_Positive_NonZero">
                                    <xs:annotation>
                                        <xs:documentation>Represents the length in metres of the
                                            lintel.</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="OutletType"
                        nillable="false" type="stormwater_pit_outlet_type">
                        <xs:annotation>
                            <xs:documentation>The type of outlet for this pit.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="FireRetardant"
                        nillable="false" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation>True or false value indicating whether fire retardant
                                measures are incorporated.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Rotation"
                        nillable="true" type="Float_Direction">
                        <xs:annotation>
                            <xs:documentation>Rotation angle (cartesian - anti-clockwise 0 degrees =
                                East)</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_point_singlepoint">
                        <xs:annotation>
                            <xs:documentation>Point geometry representing the manhole or pit feature
                                in coordinate space.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
