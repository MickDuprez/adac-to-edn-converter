                                    name="Area_m2" nillable="false" type="Float_Positive_Zero">
                                    <xs:annotation>
                                        <xs:documentation>The Outlet Protection area, in square
                                            metres</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="GrateType"
                        nillable="true" type="stormwater_grate_type">
                        <xs:annotation>
                            <xs:documentation>Type of grate used, if applicable.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="TideGate"
                        nillable="true" type="stormwater_tidegate_type">
                        <xs:annotation>
                            <xs:documentation>Type of tide or flood gate used, if
                                applicable.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_linear_singlepath_simple">
                        <xs:annotation>
                            <xs:documentation>Point geometry representing the EndStructure in
                                coordinate space.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- FEATURE STORMWATER FITTING -->
    <xs:complexType abstract="false" name="Feature_StormWater_Fitting">
        <xs:annotation>
            <xs:documentation>Represents a point fitting in a stormwater system.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="asset_abstract">
                <xs:sequence maxOccurs="1" minOccurs="1">
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="FittingType"
                        nillable="false" type="stormwater_fitting_type">
                        <xs:annotation>
                            <xs:documentation>The type of stormwater fitting.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Rotation"
                        nillable="true" type="Float_Direction">
                        <xs:annotation>
                            <xs:documentation>Rotation angle (cartesian - anti-clockwise 0 degrees =
                                East)</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_point_singlepoint">
                        <xs:annotation>
                            <xs:documentation>Point geometry representing the fitting in coordinate
                                space.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- FEATURE STORMWATER PIPE -->
    <xs:complexType abstract="false" name="Feature_StormWater_Pipe">
        <xs:annotation>
            <xs:documentation>Represents a stormwater pipe feature</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="asset_abstract">
                <xs:sequence maxOccurs="1" minOccurs="1">
                    <xs:group maxOccurs="1" minOccurs="1" ref="dimensions_invert_levels_m">
                        <xs:annotation>
                            <xs:documentation>Calls in the standard elements for upstream and
                                downstream invert levels</xs:documentation>
                        </xs:annotation>
                    </xs:group>
                    <xs:group maxOccurs="1" minOccurs="1" ref="dimensions_surface_levels_m">
                        <xs:annotation>
                            <xs:documentation>Calls in the standard elements for upstream and
                                downstream surface levels</xs:documentation>
                        </xs:annotation>
                    </xs:group>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="PipeStructure"
                        nillable="false">
                        <xs:annotation>
                            <xs:documentation>Container for a choice of pipe cross-sectional
                                measures.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                            <xs:choice>
                                <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                    name="CircPipe" nillable="false"
                                    type="stormwater_circpipe_struct">
                                    <xs:annotation>
                                        <xs:documentation>Circular pipe cross-sectional
                                            description.</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                                <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                    name="BoxPipe" nillable="false" type="stormwater_boxpipe_struct">
                                    <xs:annotation>
                                        <xs:documentation>Rectangular pipe cross-sectional
                                            description.</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                            </xs:choice>
                        </xs:complexType>
                    </xs:element>
                    <xs:element default="1" form="qualified" maxOccurs="1" minOccurs="1"
                        name="Cells" nillable="false" type="xs:positiveInteger">
                        <xs:annotation>
                            <xs:documentation>The number of cells in the pipe
                                course.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                        name="ConcreteCoverType" nillable="false" type="stormwater_conc_cover_type">
                        <xs:annotation>
                            <xs:documentation>The pipe protection regime
                                employed.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Grade"
                        nillable="true" type="Float_Positive_Zero">
                        <xs:annotation>
                            <xs:documentation>Pipe gradient as a percentage.  Derivable from invert
                                levels and horizontal length.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Length_m"
                        nillable="true" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>Pipe material length in metres.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_linear_multipath_simple">
                        <xs:annotation>
                            <xs:documentation>Polyline geometry representing the feature in
                                coordinate space.</xs:documentation>
                            <xs:documentation>The recommendation for multicell courses is to store
                                multiple paths within the polyline.  It is recommended that all
                                paths are digitised in the direction of flow.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- FEATURE STORMWATER SURFACEDRAIN -->
    <xs:complexType name="Feature_StormWater_SurfaceDrain">
        <xs:annotation>
            <xs:documentation>Represents a linear surface drain.  May include natural and
                constructed features.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="asset_abstract">
                <xs:sequence maxOccurs="1" minOccurs="1">
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Type"
                        nillable="false" type="stormwater_surface_drain_type">
                        <xs:annotation>
                            <xs:documentation>The type of drain or channel.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="DrainShape"
                        nillable="false" type="stormwater_surface_drain_shape">
                        <xs:annotation>
                            <xs:documentation>Cross-sectional shape of the drain.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="LiningMaterial"
                        nillable="false" type="stormwater_surface_drain_lining_material">
                        <xs:annotation>
                            <xs:documentation>The material that the channel is lined
                                with.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="BaseWidth_m"
                        nillable="true" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>The base width, in metres, if flat bottom, nil if vee
                                drain</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="LinedWidth_m"
                        nillable="false" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>The width, in metres, of the lined portion of the
                                channel.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="BatterMaterial"
                        nillable="true" type="stormwater_surface_drain_lining_material">
                        <xs:annotation>
                            <xs:documentation>The material that the drain batter is lined with.  A
                                null value may be supplied where the drain has no
                                batter.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="BatterWidth_m"
                        nillable="true" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>The total width, in metres, from top lip of batter to
                                opposite  top lip of batter. A null value may be supplied where the
                                drain has no batter.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:group maxOccurs="1" minOccurs="1" ref="dimensions_invert_levels_m">
                        <xs:annotation>
                            <xs:documentation>Calls in the standard elements for upstream and
                                downstream invert levels</xs:documentation>
                        </xs:annotation>
                    </xs:group>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="AverageGrade"
                        nillable="true" type="Float_Positive_Zero">
                        <xs:annotation>
                            <xs:documentation>The average gradient over the whole length of the
                                feature, as a percentage.  Derivable from the difference in invert
                                levels and the horizontal length of the geometry.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Length_m"
                        nillable="true" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>The material length, in metres, of the centreline of
                                the channel.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_linear_singlepath_simple">
                        <xs:annotation>
                            <xs:documentation>Polyline geometry representing the feature in
                                coordinate space.</xs:documentation>
                            <xs:documentation>Digitise each individual length of channel as a single
                                unbroken path.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- FEATURE STORMWATER WSUD GPTComplex -->
    <xs:complexType abstract="false" name="Feature_StormWater_GPTComplex">
        <xs:annotation>
            <xs:documentation>Represents a commerial or custom in-pit GPT unit.</xs:documentation>
            <xs:documentation>Must occur collocated with a pit.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="asset_abstract">
                <xs:sequence maxOccurs="1" minOccurs="1">
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Sqid_Id"
                        nillable="true" type="String_32">
                        <xs:annotation>
                            <xs:documentation>The string identifier of the device, as it would
                                appear on a plan.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" name="Construction">
                        <xs:complexType>
                            <xs:choice>
                                <xs:element form="qualified" name="Commercial">
                                    <xs:complexType>
                                        <xs:sequence maxOccurs="1" minOccurs="1">
                                            <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                                name="Manufacturer" nillable="false"
                                                type="String_64">
                                                <xs:annotation>
                                                  <xs:documentation>The Manufacturer of the
                                                  unit</xs:documentation>
                                                </xs:annotation>
                                            </xs:element>
                                            <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                                name="ModelNumber" nillable="false" type="String_64">
                                                <xs:annotation>
                                                  <xs:documentation>The standard code, model number
                                                  or part number for the unit</xs:documentation>
                                                </xs:annotation>
                                            </xs:element>
                                            <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                                name="Size" nillable="true">
                                                <xs:annotation>
                                                  <xs:documentation>The planimetric size of the
                                                  device.  This element is nillable because the
                                                  manufacturer and model are mandatory, but if
                                                  capture software designers wish to automatically
                                                  populate the sizes from a list of known device
                                                  models, then all of the appropriate dimensions
                                                  must be supplied</xs:documentation>
                                                </xs:annotation>
                                                <xs:complexType>
                                                  <xs:choice maxOccurs="1" minOccurs="1">
                                                  <xs:element form="qualified" maxOccurs="1"
                                                  minOccurs="1" name="Rectangular" nillable="false"
                                                  type="rectangular_struct_mm">
                                                  <xs:annotation>
                                                  <xs:documentation>Planimetric dimensions of a
                                                  rectangular device.</xs:documentation>
                                                  </xs:annotation>
                                                  </xs:element>
                                                  <xs:element form="qualified" maxOccurs="1"
                                                  minOccurs="1" name="Circular" nillable="false"
                                                  type="circular_struct_mm">
                                                  <xs:annotation>
                                                  <xs:documentation>Planimetric dimensions of a
                                                  circular device.</xs:documentation>
                                                  </xs:annotation>
                                                  </xs:element>
                                                  </xs:choice>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element form="qualified" name="Custom">
                                    <xs:complexType>
                                        <xs:sequence maxOccurs="1" minOccurs="1">
                                            <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                                                name="Size" nillable="false">
                                                <xs:annotation>
                                                  <xs:documentation>The dimensions of the device.
                                                  This element is mandatory for custom built
                                                  devices.  The appropriate dimensions must be
                                                  supplied</xs:documentation>
                                                </xs:annotation>
                                                <xs:complexType>
                                                  <xs:choice maxOccurs="1" minOccurs="1">
                                                  <xs:element form="qualified" maxOccurs="1"
                                                  minOccurs="1" name="Rectangular" nillable="false"
                                                  type="rectangular_struct_mm">
                                                  <xs:annotation>
                                                  <xs:documentation>Planimetric dimensions of a
                                                  rectangular device.</xs:documentation>
                                                  </xs:annotation>
                                                  </xs:element>
                                                  <xs:element form="qualified" maxOccurs="1"
                                                  minOccurs="1" name="Circular" nillable="false"
                                                  type="circular_struct_mm">
                                                  <xs:annotation>
                                                  <xs:documentation>Planimetric dimensions of a
                                                  circular device.</xs:documentation>
                                                  </xs:annotation>
                                                  </xs:element>
                                                  </xs:choice>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                            </xs:choice>
                        </xs:complexType>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Function1"
                        nillable="false" type="stormwater_wsud_GPTComplex_function">
                        <xs:annotation>
                            <xs:documentation>The first function of the WSUD point. The device must
                                have at least one function.  Usually Gross Pollutant Capture will be
                                the most important function.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Function2"
                        nillable="true" type="stormwater_wsud_GPTComplex_function">
                        <xs:annotation>
                            <xs:documentation>The second function of the WSUD point, if
                                applicable</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Function3"
                        nillable="true" type="stormwater_wsud_GPTComplex_function">
                        <xs:annotation>
                            <xs:documentation>The third function of the device, if
                                applicable</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                        name="US_PipeDiameter_mm" nillable="true" type="xs:positiveInteger">
                        <xs:annotation>
                            <xs:documentation>The upstream pipe diameter in
                                millimetres</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                        name="DS_PipeDiameter_mm" nillable="true" type="xs:positiveInteger">
                        <xs:annotation>
                            <xs:documentation>The downstream pipe diameter in
                                millimetres</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="SurfaceLevel_m"
                        nillable="false" type="xs:float">
                        <xs:annotation>
                            <xs:documentation>The surface level at the top of the
                                device</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:group maxOccurs="1" minOccurs="1" ref="dimensions_invert_levels_m">
                        <xs:annotation>
                            <xs:documentation>Calls in the standard elements for upstream and
                                downstream invert levels</xs:documentation>
                        </xs:annotation>
                    </xs:group>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="CleanoutLevel_m"
                        nillable="false" type="xs:float">
                        <xs:annotation>
                            <xs:documentation>The level to which the device must be cleaned out, in
                                metres against the vertical datum of the project.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Depth_m"
                        nillable="true" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>The depth, in metres, of the
                                device.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="SumpDepth_m"
                        nillable="true" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>The depth, in metres, of the sump, if
                                applicable</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="HasFilterMedia"
                        nillable="true" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation>True if the device has filtration media or a filter
                                capsule installed.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="HasBasket"
                        nillable="true" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation>True if the device has a litter basket
                                installed.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="HasBoards"
                        nillable="true" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation>True if the device has drop-boards or penstock
                                installed.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="DesignFlow_m3s"
                        nillable="false" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>Design Flow in cubic metres per
                                second</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                        name="MaxContaminantVolume_m3" nillable="true" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>Maximum contaminant retention volume in cubic
                                metres.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                        name="MaxInternalVolume_m3" nillable="true" type="Float_Positive_NonZero">
                        <xs:annotation>
                            <xs:documentation>Maximum internal volume in cubic
                                metres.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                        name="MaintenanceCycle_mnths" nillable="true" type="xs:positiveInteger">
                        <xs:annotation>
                            <xs:documentation>The minimum maintenance cycle in months (refer to
                                specifications)</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element default="0" form="qualified" maxOccurs="1" minOccurs="1"
                        name="Rotation" nillable="true" type="Float_Direction">
                        <xs:annotation>
                            <xs:documentation>Rotation angle (cartesian - anti-clockwise 0 degrees =
                                East)</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_point_singlepoint">
                        <xs:annotation>
                            <xs:documentation>Point geometry representing the feature in coordinate
                                space.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- FEATURE STORMWATER WSUD GPTSimple -->
    <xs:complexType abstract="false" name="Feature_StormWater_GPTSimple">
        <xs:annotation>
            <xs:documentation>Represents a Water Sensitive Urban Design point feature that is a
                simple grate, basket or net fitted to existing infrastructure.</xs:documentation>
            <xs:documentation>Includes custom In-Pit or End-of-Line features or In-Line features
                such as trash-racks on drainage lines.</xs:documentation>
            <xs:documentation>Spatially, these features must be collocated with pits, endstructures
                or placed on pipes or drainage lines.  Therefore, as in reality, whether the feature
                is In-Pit, In-Line or End-of-Line is determined by its placement with other
                features.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="asset_abstract">
                <xs:sequence maxOccurs="1" minOccurs="1">
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Sqid_Id"
                        nillable="true" type="String_32">
                        <xs:annotation>
                            <xs:documentation>The string identifier of the device, as it would
                                appear on a plan.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Construction"
                        nillable="false" type="construction_method">
                        <xs:annotation>
                            <xs:documentation>The construction method</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:group maxOccurs="1" minOccurs="1" ref="manufacturer_model_details">
                        <xs:annotation>
                            <xs:documentation>Standard element group called in to support
                                manufacturer and model details</xs:documentation>
                        </xs:annotation>
                    </xs:group>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="TreatmentMeasure"
                        nillable="false" type="stormwater_wsud_GPTSimple_measure">
                        <xs:annotation>
                            <xs:documentation>The treatment measure employed</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element fixed="Gross Pollutant Capture" form="qualified" maxOccurs="1"
                        minOccurs="1" name="Function1" nillable="false" type="String_32">
                        <xs:annotation>
                            <xs:documentation>The first function of the WSUD point.  Has a fixed
                                value because all GPTSimple points are considered Gross Pollutant
                                Capture devices.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Length_mm"
                        nillable="false" type="xs:positiveInteger">
                        <xs:annotation>
                            <xs:documentation>The length of the device</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Width_mm"
                        nillable="true" type="xs:positiveInteger">
                        <xs:annotation>
                            <xs:documentation>The width of the device</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Material"
                        nillable="true" type="String_64">
                        <xs:annotation>
                            <xs:documentation>Predominant material of device</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1"
                        name="MaintenanceCycle_mnths" nillable="true" type="xs:positiveInteger">
                        <xs:annotation>
                            <xs:documentation>The minimum maintenance cycle in months. This is the
                                revisit interval for clearing captured rubbish.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element default="0" form="qualified" maxOccurs="1" minOccurs="1"
                        name="Rotation" nillable="true" type="Float_Direction">
                        <xs:annotation>
                            <xs:documentation>Rotation angle (cartesian - anti-clockwise 0 degrees =
                                East)</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_point_singlepoint">
