    <xs:simpleType name="sewer_house_connection_type">
        <xs:annotation>
            <xs:documentation>Type of connections</xs:documentation>
        </xs:annotation>
        <xs:restriction base="String_32">
            <xs:enumeration value="Sloped Branch">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer via an oblique junction
                        serving a single property with no change in grade along the inclined
                        property connection sewer with no vertical bends. Also known as Standard or
                        Type A Property Connection.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Twin Sloped Branch">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer via an oblique junction
                        serving 2 properties with no change in grade along the inclined property
                        connection sewer with no vertical bends. Also known as Standard or Twin or
                        Dual Type A Property Connection</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Ramp Riser">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer via an oblique junction
                        serving a single property where the property connection sewer incorporates
                        either or both a section laid at a steeper grade and vertical bends. Also
                        known as Type B Property Connection.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Twin Ramp Riser">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer via an oblique junction
                        serving 2 properties where the property connection sewer incorporates either
                        or both a section laid at a steeper grade and vertical bends. Also known as
                        Twin or Dual Type B Property Connection.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Jump Up">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer via a vertical oblique
                        junction serving a single property where the property connection sewer
                        incorporates either or both a section laid at a steeper grade and vertical
                        bends. Also known a Type C or Type D Property Connection.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Twin Jump Up">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer via a vertical oblique
                        junction serving 2-4 properties and incorporating a change in elevation of
                        the property connection sewer via a vertical drop/jump up. Also known as
                        Twin or Dual Vertical Riser, Type C or Type D Property
                        Connection.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Sloped into MS Base">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer into the base of a
                        maintenance structure serving a single property with no change in grade
                        along the property connection sewer and no vertical bends. Also known as
                        Standard or Type A Connection</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Twin Sloped into MS Base">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer into the base of a
                        maintenance structure serving 2 properties with no change in grade along the
                        property connection sewer and no vertical bends. Also known as Standard or
                        Type A Connection</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Ramp into MS Base">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer into the base of a
                        maintenance structure serving a single property where the property
                        connection sewer incorporates either or both a section laid at a steeper
                        grade and vertical bends. Also known as Type B Connection</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Twin Ramp into MS Base">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer into the base of a
                        maintenance structure serving  2 properties where the property connection
                        sewer incorporates either or both a section laid at a steeper grade and
                        vertical bends. Also known as Type B Connection</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Drop into MS Base">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer into the shaft of a
                        maintenance shaft or via a drop entry into a maintenance hole and serving a
                        single property. Also known as Vertical Riser, Type C or Type D
                        Connection</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Twin Drop into MS Base">
                <xs:annotation>
                    <xs:documentation>Connection to the reticulation sewer into the shaft of a
                        maintenance shaft or via a drop entry into a maintenance hole and serving 2
                        properties. Also known as Vertical Riser, Type C or Type D
                        Connection</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Stub">
                <xs:annotation>
                    <xs:documentation>Obsolete designation for a connection into a Maintenance Hole,
                        which is no longer used and only retained for backwards
                        compatibility</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Unknown">
                <xs:annotation>
                    <xs:documentation>Unknown type of property connection</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Other">
                <xs:annotation>
                    <xs:documentation>Some other type of Connection not covered by the standard
                        types</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
