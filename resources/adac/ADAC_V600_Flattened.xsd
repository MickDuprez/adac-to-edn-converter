    </xs:complexType>
    <!-- FEATURE Supplementary POLYGON -->
    <xs:complexType abstract="false" name="Feature_Supplementary_Polygon">
        <xs:annotation>
            <xs:documentation>Represents a Supplementary polygon feature.    Use these features to
                represent area detail that adds clarity or context to the strict ADAC
                features.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <!--Ben Pham modified: changed base extension from object_abstract to asset_abstract-->
