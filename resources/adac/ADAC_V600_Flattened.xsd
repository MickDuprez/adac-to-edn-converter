    <!-- ABSTRACT TYPES  extended by all feature types-->
    <xs:complexType abstract="true" name="object_abstract">
        <xs:annotation>
            <xs:documentation>All feature level objects in the schema will inherit from
                object_abstract</xs:documentation>
        </xs:annotation>
        <xs:sequence maxOccurs="1" minOccurs="1">
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="ADACId" nillable="false"
                type="String_64">
                <xs:annotation>
                    <xs:documentation>Represents a place for an object identifier, usually generated
                        by the data creation software.  Also useful as a placeholder for record ID
                        generated by back-end databases or GIS</xs:documentation>
                    <xs:documentation>The ADACId is permitted to be nil because the capturing system
                        may not have the capacity to generate one.  If features are exported from a
                        GIS or Asset Management system, however, it is highly recommended to carry
                        them out into this element.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType abstract="true" name="asset_abstract">
        <xs:annotation>
            <xs:documentation>All Asset feature objects in the schema will inherit from
                asset_abstract</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="object_abstract">
                <xs:sequence maxOccurs="1" minOccurs="1">
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="ComponentInfo"
                        nillable="false" type="component_info_struct">
                        <xs:annotation>
                            <xs:documentation>Data container for generic asset
                                information.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType abstract="false" name="component_info_struct">
        <xs:annotation>
            <xs:documentation>Data structure for generic asset information.  Common to all asset
                classes.</xs:documentation>
        </xs:annotation>
        <xs:sequence maxOccurs="1" minOccurs="1">
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="InfrastructureCode"
                nillable="true" type="String_64">
                <xs:annotation>
                    <xs:documentation>The code or number of an Infrastructure Charges Plan, any
                        asset feature codes; any ETL software codes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Owner" nillable="true"
                type="String_32">
                <xs:annotation>
                    <xs:documentation>The entity that owns or is responsible for the
                        asset.</xs:documentation>
                    <xs:documentation>Used with the Department field to differentiate a sub-set of
                        assets for an XML with multiple asset owners.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="DrawingNumber"
                nillable="true" type="String_64">
                <xs:annotation>
                    <xs:documentation>The Council drawing number of the as constructed plans.  This
                        may not be known at the time of compilation.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="DrawingRevision"
                nillable="true" type="xs:date">
                <xs:annotation>
                    <xs:documentation>Date the drawing was revised.  ISO 8601 is the accepted
                        format.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="ConstructionDate"
                nillable="true" type="xs:date">
                <xs:annotation>
                    <xs:documentation>The accepted date of construction for the whole project.
                        Usually the project completion date.  ISO 8601 is the accepted
                        format.</xs:documentation>
                    <xs:documentation>Date may be used to calculate remaining life in an asset
                        management system.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Department"
                nillable="true" type="String_32">
                <xs:annotation>
                    <xs:documentation>Department is used to differentiate between assets with a
                        common owner that need to go into separate GIS layers or asset
                        registers.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <!--Ben Pham added: Surveyor and Engineer elements.-->
            <!-- Certifying Surveyor -->
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Surveyor" nillable="true"
                type="surveyor_details"/>
            <!-- Certifying Engineer -->
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Engineer" nillable="true"
                type="engineer_details"/>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Status" nillable="false"
                type="asset_status">
                <xs:annotation>
                    <xs:documentation>The operational or existential status of the asset at the time
                        the data was captured.  A Project may contain a mix of planned and existing
                        assets as well as operational and retired assets.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <!--Ben Pham added: DataQuality and Deparment elements.-->
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="DataQuality"
                nillable="true" type="data_quality">
                <xs:annotation>
                    <xs:documentation>Data Quality based on AS5488-2013. Classification of
                        Subsurface Utility Information.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Notes" nillable="true"
                type="String_254">
                <xs:annotation>
                    <xs:documentation>Free text notes particular to this feature.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="SupportingFiles"
                nillable="true">
                <xs:complexType>
                    <xs:sequence maxOccurs="1" minOccurs="1">
                        <xs:element form="qualified" maxOccurs="unbounded" minOccurs="0"
                            name="SupportingFile" nillable="false" type="String_254">
                            <xs:annotation>
                                <xs:documentation>Full path and filename of supporting information
                                    (e.g. drawing file, document file or image).  It is recommended
                                    that the filename is relative to the URI of the ADAC XML
                                    document, E.g: ./images/image1.jpg</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
