            <xs:enumeration value="Left-Centre">
                <xs:annotation>
                    <xs:documentation>Left-Centre</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Left-Top">
                <xs:annotation>
                    <xs:documentation>Left-Top</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Centre-Bottom">
                <xs:annotation>
                    <xs:documentation>Centre-Bottom</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Centre-Centre">
                <xs:annotation>
                    <xs:documentation>Centre-Centre</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Centre-Top">
                <xs:annotation>
                    <xs:documentation>Centre-Top</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Right-Bottom">
                <xs:annotation>
                    <xs:documentation>Right-Bottom</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Right-Centre">
                <xs:annotation>
                    <xs:documentation>Right-Centre</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Right-Top">
                <xs:annotation>
                    <xs:documentation>Right-Top</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="which_side">
        <xs:annotation>
            <xs:documentation>Determines which side to apply an offset or measurement in the
                direction of travel</xs:documentation>
        </xs:annotation>
        <xs:restriction base="String_32">
            <xs:enumeration value="Left">
                <xs:annotation>
                    <xs:documentation>Left hand side</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Right">
                <xs:annotation>
                    <xs:documentation>Right hand side</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="Float_Positive_Zero">
        <xs:annotation>
            <xs:documentation>Decimal number greater than or equal to zero</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:float">
            <xs:minInclusive value="0">
                <xs:annotation>
                    <xs:documentation>greater than or equal to zero</xs:documentation>
                </xs:annotation>
            </xs:minInclusive>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="Float_Positive_NonZero">
        <xs:annotation>
            <xs:documentation>Decimal number greater than zero</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:float">
            <xs:minExclusive value="0">
                <xs:annotation>
                    <xs:documentation>greater than zero</xs:documentation>
                </xs:annotation>
            </xs:minExclusive>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="Float_Direction">
        <xs:annotation>
            <xs:documentation>Decimal number representing an angle in degrees. Limited to one full
                rotation in either direction.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:float">
            <xs:minExclusive value="-360">
                <xs:annotation>
                    <xs:documentation>One full rotation counterclockwise from north for bearings or
                        clockwise fom X-Axis for mathematical.</xs:documentation>
                </xs:annotation>
            </xs:minExclusive>
            <xs:maxExclusive value="360">
                <xs:annotation>
                    <xs:documentation>One full rotation clockwise from north for bearings or
                        counterclockwise fom X-Axis for mathematical.</xs:documentation>
                </xs:annotation>
            </xs:maxExclusive>
        </xs:restriction>
    </xs:simpleType>
