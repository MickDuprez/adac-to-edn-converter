            </xs:enumeration>
            <xs:enumeration value="Sand Filtration">
                <xs:annotation>
                    <xs:documentation>Sand Filtration occurs in a sand layer designed to filter fine
                        particulates from stormwater before discharging to a downstream drainage
                        system.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Infiltration">
                <xs:annotation>
                    <xs:documentation>Infiltration measures typically consist of holding pond or
