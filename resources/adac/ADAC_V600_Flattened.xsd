    <xs:complexType name="named_attribute_timevalue">
        <xs:annotation>
            <xs:documentation>Represents a time of the W3C form hh:mm:ss.s (e.g: 23:59:59.9).  this
                form assumes the local timezone.</xs:documentation>
            <xs:documentation>For time in UTC (timezone Zulu), format is hh:mm:ssZ (e.g:
                23:59:59Z)</xs:documentation>
            <xs:documentation>For time in a timezone an offset in hours and minutes must be
