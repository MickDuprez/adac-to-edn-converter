                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <!-- Element group for supplementary feature contents -->
    <xs:group name="supplementary_content">
        <xs:annotation>
            <xs:documentation>Standard content for supplementary features</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Class" nillable="false"
                type="String_32">
                <xs:annotation>
                    <xs:documentation>User specified class names may be encoded here to identify the
                        feature type.  As there is no enumeration, the class codes must be by prior
                        agreement.</xs:documentation>
                    <xs:documentation>Not to be used for features that appear elsewhere in the ADAC
                        Model.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Note" nillable="true"
                type="String_254">
                <xs:annotation>
                    <xs:documentation>General purpose descriptive note.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Attributes"
                nillable="true" type="attribute_collection">
                <xs:annotation>
                    <xs:documentation>a collection of named attributes.</xs:documentation>
                    <xs:documentation>This element must be present but may be
                        empty.</xs:documentation>
                    <xs:documentation>Attributes of supported types may occur in any number and any
                        order, but application developers are encouraged to exercise consistency in
                        the use of supplementary attributes.  It is recommended that supplementary
                        features given the same class are also given the same list of named
                        attributes in the same order, so as to facilitate easier passage into
                        receiving systems.  Attribute names should be chosen with the requirements
                        of receiving systems in mind.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:group>
    <!-- Building blocks for named attributes -->
    <xs:complexType name="attribute_collection">
        <xs:annotation>
            <xs:documentation>This type controls the content of a collection of named attributes in
                any order.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:group maxOccurs="unbounded" minOccurs="0" ref="named_attributes">
                <xs:annotation>
                    <xs:documentation>Any one of the named attributes may be used in any
                        order.</xs:documentation>
                </xs:annotation>
            </xs:group>
        </xs:sequence>
    </xs:complexType>
    <!-- Group for named attributes -->
    <xs:group name="named_attributes">
        <xs:annotation>
            <xs:documentation>This group enables a named attribute of any supported data type to be
                defined</xs:documentation>
        </xs:annotation>
        <xs:choice>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="TextValue"
                nillable="true" type="named_attribute_textvalue">
                <xs:annotation>
                    <xs:documentation>Represents a text string value.  The length is not specified,
                        so it is the responsibility of data authors and software implementers to
                        ensure that values are suitable for any particular
                        application.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="IntegerValue"
                nillable="true" type="named_attribute_integervalue">
                <xs:annotation>
                    <xs:documentation>Represents an integer numeric value, that may be positive or
                        negative.  The bounds are not specified, so it is the responsibility of data
                        authors and software implementers to ensure that values are suitable for any
                        particular application.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="DecimalValue"
                nillable="true" type="named_attribute_decimalvalue">
                <xs:annotation>
                    <xs:documentation>Represents a decimal numeric value, that may be positive or
                        negative. The bounds are not specified, so it is the responsibility of data
                        authors and software implementers to ensure that values are suitable for any
                        particular application.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="DateValue"
                nillable="true" type="named_attribute_datevalue">
                <xs:annotation>
                    <xs:documentation>Represents a date of the W3C form YYYY-MM-DD (e.g:
                        2012-08-01).  This form assumes the local timezone.</xs:documentation>
                    <xs:documentation>For date in UTC (timezone Zulu), format is YYYY-MM-DDZ (e.g:
                        2012-08-01Z)</xs:documentation>
                    <xs:documentation>For date in a timezone an offset in hours and minutes must be
                        specified, format is YYYY-MM-DD+hh:mm [offset can be positive or negative]
                        (e.g: 2012-08-01+10:00)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="TimeValue"
                nillable="true" type="named_attribute_timevalue">
                <xs:annotation>
                    <xs:documentation>Represents a time of the W3C form hh:mm:ss.s (e.g:
                        23:59:59.9).  this form assumes the local timezone.</xs:documentation>
                    <xs:documentation>For time in UTC (timezone Zulu), format is hh:mm:ssZ (e.g:
                        23:59:59Z)</xs:documentation>
                    <xs:documentation>For time in a timezone an offset in hours and minutes must be
                        specified, format is hh:mm:ss+hh:mm [offset can be positive or negative]
                        (e.g: 23:59:59+10:00)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="DateTimeValue"
                nillable="true" type="named_attribute_datetimevalue">
                <xs:annotation>
                    <xs:documentation>Represents a date-time of the W3C form YYYY-MM-DDThh:mm:ss.s
                        (e.g: 2012-08-01T20:00:00.0).  this form assumes the local
                        timezone.</xs:documentation>
                    <xs:documentation>For date and time in UTC (timezone Zulu), format is
                        YYYY-MM-DDhh:mm:ssZ (e.g: 2012-08-01T20:00:00Z)</xs:documentation>
                    <xs:documentation>For date and time in a timezone an offset in hours and minutes
                        must be specified, format is YYYY-MM-DDThh:mm:ss+hh:mm [offset can be
                        positive or negative] (e.g: 2012-08-01T20:00:00+10:00)</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
    </xs:group>
    <xs:complexType name="named_attribute_textvalue">
        <xs:annotation>
            <xs:documentation>Represents a text string value.  The length is not specified, so it is
                the responsibility of data authors and software implementers to ensure that values
                are suitable for any particular application.</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute form="unqualified" name="valname" type="String_32" use="required">
                    <xs:annotation>
                        <xs:documentation>A name must be supplied for the Feature Attribute.
                            Typically this name will used as a field name in a receiving database or
                            GIS.  It is the implementers responsibility to ensure that the name
                            adheres to the requirements of receiving systems. Usually this means no
                            spaces, alphanumerics only and a limit to the number of
                            characters.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="named_attribute_integervalue">
