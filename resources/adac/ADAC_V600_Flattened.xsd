    <!-- Features - Contains the specification for all OpenSpace Features                         -->
    <!-- **************************************************************************************** -->
    <!-- Feature OpenSpace OpenSpace Area -->
    <xs:complexType name="Feature_OpenSpace_OpenSpaceArea">
        <xs:annotation>
            <xs:documentation>Represents a top-level area of open space regarded as a single
                functional area, such as a park or recreation area.  May be, but not necessarily,
                coincident with cadastral boundary.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="asset_abstract">
                <xs:sequence maxOccurs="1" minOccurs="1">
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Name"
                        nillable="false" type="String_64">
                        <xs:annotation>
                            <xs:documentation>                 The offical  name or description  of
                                the Open Space area  (eg: Smith St Park, Stockland Park Sporting
                                complex)               </xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Type"
                        nillable="false" type="openspace_area_type">
                        <xs:annotation>
                            <xs:documentation>                 The type of Open Space area eg:
                                Recreational, Bushland, Sporting Complex
                            </xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element form="qualified" maxOccurs="1" minOccurs="1" name="Geometry"
                        nillable="false" type="geometry_area_multipatch_complex">
                        <xs:annotation>
                            <xs:documentation>The geometry representing this feature in coordinate
